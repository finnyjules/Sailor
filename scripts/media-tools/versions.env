# The video tools' pinned sources (Task R5.1a). Read by build.sh and by
# frontend/tests/unit/media-tools.unit.spec.ts. Plain KEY=value lines only:
# no spaces around '=', no quotes, no shell expansion.
#
# Every part has <PART>_VERSION, <PART>_URL (https) and <PART>_SHA256 (64 hex).
# A sha256 of TODO-VERIFY makes build.sh stop after the download and print the
# file's real sha256, so it can be checked and pasted here. See README.md.

# FFmpeg 8.0.3 (8.0 branch, the same branch as PyAV 17.0.0's FFmpeg). LGPL 2.1+.
# ffmpeg.org publishes no sha256; its release is signed with the key below
# (fingerprint listed on https://ffmpeg.org/download.html, and the issuer of
# https://ffmpeg.org/releases/ffmpeg-8.0.3.tar.xz.asc). Fill FFMPEG_SHA256 only
# after build.sh reports "signature: good".
FFMPEG_VERSION=8.0.3
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-8.0.3.tar.xz
FFMPEG_SHA256=6136812ea6d4e68bdba27e33c2a94382711cdf4f8602ffef056ff792bd6f9818
FFMPEG_SIG_URL=https://ffmpeg.org/releases/ffmpeg-8.0.3.tar.xz.asc
FFMPEG_KEY_URL=https://ffmpeg.org/ffmpeg-devel.asc
FFMPEG_KEY_FINGERPRINT=FCF986EA15E6E293A5644F10B4322F04D67658D8

# OpenH264 2.5.1 (tag "2.5.1", no "v"; same .so.7 generation as PyAV's
# libopenh264.7). BSD 2-clause. Cisco publishes no source checksum; GitHub's
# tag archive is hashed on first download.
OPENH264_VERSION=2.5.1
OPENH264_URL=https://github.com/cisco/openh264/archive/refs/tags/2.5.1.tar.gz
OPENH264_SHA256=a1b5c88bfb31c4d2251835e57a7df99f91181955cea6ec3ddd4ab82aa54ae9f1

# LAME 3.100 (the version PyAV bundles as libmp3lame.0). LGPL 2.
# sha256 from SourceForge's own file listing for lame/3.100/lame-3.100.tar.gz
# (sha1 64c53b1a4d493237cef5e74944912cd9f98e618d, md5 83e260acbe4389b54fe08e0bdbf7cddb).
LAME_VERSION=3.100
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# Opus 1.5.2. BSD 3-clause. sha256 from https://downloads.xiph.org/releases/opus/SHA256SUMS.txt
OPUS_VERSION=1.5.2
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz
OPUS_SHA256=65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1

# dav1d 1.5.1. BSD 2-clause. sha256 from
# https://downloads.videolan.org/pub/videolan/dav1d/1.5.1/dav1d-1.5.1.tar.xz.sha256
DAV1D_VERSION=1.5.1
DAV1D_URL=https://downloads.videolan.org/pub/videolan/dav1d/1.5.1/dav1d-1.5.1.tar.xz
DAV1D_SHA256=401813f1f89fa8fd4295805aa5284d9aed9bc7fc1fdbe554af4292f64cbabe21

# zlib 1.3.2 (2026-02-17). zlib licence. Needed for parity: PyAV's FFmpeg is
# built with zlib (PNG and other deflate-based codecs, compressed MOV headers).
# Built from source and linked statically, like the rest, so the Mac and Fly
# builds are the same. The file is the maker's own GitHub release asset; the
# sha256 is the one https://zlib.net/ publishes for zlib-1.3.2.tar.xz.
ZLIB_VERSION=1.3.2
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.xz
ZLIB_SHA256=d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3

# Build time stamp for every part: FFmpeg 8.0.3's release day, 2026-06-18 00:00 UTC.
MEDIA_TOOLS_SOURCE_DATE_EPOCH=1781740800
