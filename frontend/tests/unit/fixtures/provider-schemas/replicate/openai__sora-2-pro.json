  "input": {
    "$ref": "#/components/schemas/Input"
  },
  "output": {
    "$ref": "#/components/schemas/Output"
  },
  "components": {
    "schemas": {
      "Input": {
        "type": "object",
        "title": "Input",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "x-order": 1,
            "description": "A text description of the video to generate"
          },
          "seconds": {
            "allOf": [
              {
                "$ref": "#/components/schemas/seconds"
              }
            ],
            "default": 4,
            "x-order": 3,
            "description": "Duration of the video in seconds"
          },
          "resolution": {
            "allOf": [
              {
                "$ref": "#/components/schemas/resolution"
              }
            ],
            "default": "standard",
            "x-order": 5,
            "description": "Resolution quality. Standard is 720p (1280x720 landscape, 720x1280 portrait). High is 1024p (1792x1024 landscape, 1024x1792 portrait)."
          },
          "aspect_ratio": {
            "allOf": [
              {
                "$ref": "#/components/schemas/aspect_ratio"
              }
            ],
            "default": "portrait",
            "x-order": 4,
            "description": "Aspect ratio of the video"
          },
          "openai_api_key": {
            "type": "string",
            "title": "Openai Api Key",
            "format": "password",
            "x-order": 0,
            "nullable": true,
            "writeOnly": true,
            "description": "Optional: Your OpenAI API key. If you use your own OpenAI API key, you will be charged directly by OpenAI.",
            "x-cog-secret": true
          },
          "input_reference": {
            "type": "string",
            "title": "Input Reference",
            "format": "uri",
            "x-order": 2,
            "nullable": true,
            "description": "An optional image to use as the first frame of the video. The image must be the same aspect ratio as the video."
          }
        }
      },
      "seconds": {
        "enum": [
          4,
          8,
          12
        ],
        "type": "integer",
        "title": "seconds",
        "description": "An enumeration."
      },
      "resolution": {
        "enum": [
          "standard",
          "high"
        ],
        "type": "string",
        "title": "resolution",
        "description": "An enumeration."
      },
      "aspect_ratio": {
        "enum": [
          "portrait",
          "landscape"
        ],
        "type": "string",
        "title": "aspect_ratio",
        "description": "An enumeration."
      },
      "Output": {
        "type": "string",
        "title": "Output",
        "format": "uri"
      }
