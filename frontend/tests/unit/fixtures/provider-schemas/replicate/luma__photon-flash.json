{
  "endpoint": "luma/photon-flash",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://api.replicate.com/v1/models/luma/photon-flash"
  },
  "versionId": "8cee7d47f81d8f4f77c1aec44ffb3d1ce09d36388db637ceaa8a6cbcf30b63e1",
  "input": {
    "$ref": "#/components/schemas/Input"
  },
  "output": {
    "$ref": "#/components/schemas/Output"
  },
  "components": {
    "schemas": {
      "Input": {
        "type": "object",
        "title": "Input",
        "required": [
          "prompt"
        ],
        "properties": {
          "seed": {
            "type": "integer",
            "title": "Seed",
            "description": "Random seed. Set for reproducible generation"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "Text prompt for image generation"
          },
          "aspect_ratio": {
            "allOf": [
              {
                "$ref": "#/components/schemas/aspect_ratio"
              }
            ],
            "default": "16:9",
            "x-order": 1,
            "description": "Aspect ratio of the generated image"
          },
          "image_reference": {
            "type": "string",
            "title": "Image Reference",
            "format": "uri",
            "description": "Reference image to guide generation"
          },
          "style_reference": {
            "type": "string",
            "title": "Style Reference",
            "format": "uri",
            "description": "Style reference image to guide generation"
          },
          "character_reference": {
            "type": "string",
            "title": "Character Reference",
            "format": "uri",
            "description": "Character reference image to guide generation"
          },
          "image_reference_url": {
            "type": "string",
            "title": "Image Reference Url",
            "deprecated": true,
            "description": "Deprecated: Use image_reference instead"
          },
          "style_reference_url": {
            "type": "string",
            "title": "Style Reference Url",
            "deprecated": true,
            "description": "Deprecated: Use style_reference instead"
          },
          "image_reference_weight": {
            "type": "number",
            "title": "Image Reference Weight",
            "default": 0.85,
            "maximum": 1,
            "minimum": 0,
            "description": "Weight of the reference image. Larger values will make the reference image have a stronger influence on the generated image."
          },
          "style_reference_weight": {
            "type": "number",
            "title": "Style Reference Weight",
            "default": 0.85,
            "maximum": 1,
            "minimum": 0,
            "description": "Weight of the style reference image"
          },
          "character_reference_url": {
            "type": "string",
            "title": "Character Reference Url",
            "deprecated": true,
            "description": "Deprecated: Use character_reference instead"
          }
        }
      },
      "aspect_ratio": {
        "enum": [
          "1:1",
          "3:4",
          "4:3",
          "9:16",
          "16:9",
          "9:21",
          "21:9"
        ],
        "type": "string",
        "title": "aspect_ratio",
        "description": "An enumeration."
      },
      "Output": {
        "type": "string",
        "title": "Output",
        "format": "uri"
      }
    }
  }
