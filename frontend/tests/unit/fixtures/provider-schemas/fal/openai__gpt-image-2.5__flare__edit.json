{
  "endpoint": "openai/gpt-image-2.5/flare/edit",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=openai/gpt-image-2.5/flare/edit",
    "pricing": "https://fal.ai/models/openai/gpt-image-2.5/flare/edit/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/GptImage25FlareEditInput"
  },
  "output": {
    "$ref": "#/components/schemas/GptImage25FlareEditOutput"
  },
  "components": {
    "schemas": {
      "GptImage25FlareEditInput": {
        "type": "object",
        "description": "GPT Image 2.5 edit inputs with model-specific quality and compression.",
        "required": [
          "prompt",
          "image_urls"
        ],
        "title": "GPTImage25EditImageRequest",
        "properties": {
          "prompt": {
            "examples": [
              "Same workers, same beam, same lunch boxes - but they're all on their phones now. One is taking a selfie. One is on a call looking annoyed. Same danger, new priorities. A hard hat has AirPods."
            ],
            "type": "string",
            "description": "The prompt for image generation",
            "minLength": 1,
            "title": "Prompt",
            "maxLength": 32000
          },
          "num_images": {
            "examples": [
              1
            ],
            "type": "integer",
            "maximum": 10,
            "description": "Number of images to generate",
            "minimum": 1,
            "default": 1,
            "title": "Number of Images"
          },
          "output_compression": {
            "description": "Compression level from 0 to 100. Only supported when output_format is 'jpeg' or 'webp'.",
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer",
                "maximum": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Compression"
          },
          "quality": {
            "title": "Quality",
            "type": "string",
            "description": "Quality for the generated image. Higher settings increase detail, latency, and token usage. Use 'auto' to let the model choose.",
            "enum": [
              "auto",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "high"
          },
          "image_size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto"
                ]
              }
            ],
            "description": "The size of the generated image. Use 'auto' to infer from input images.",
            "default": "auto",
            "title": "Image Size"
          },
          "image_urls": {
            "examples": [
              [
                "https://v3b.fal.media/files/b/0a8691af/9Se_1_VX1wzTjjTOpWbs9_bb39c2eb-1a41-4749-b1d0-cf134abc8bbf.png"
              ]
            ],
            "description": "The URLs of the images to use as a reference for the generation. A maximum of 16 images are allowed.",
            "maxItems": 16,
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Image URLs"
          },
          "output_format": {
            "type": "string",
            "description": "Output format for the images",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "title": "Output Format",
            "default": "png"
          },
          "background": {
            "type": "string",
            "description": "Background for the generated image",
            "enum": [
              "auto",
              "transparent",
              "opaque"
            ],
            "title": "Background",
            "default": "auto"
          },
          "mask_url": {
            "description": "The URL of the mask image to use for the generation. This indicates what part of the image to edit.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mask URL"
          },
          "sync_mode": {
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "default": false,
            "title": "Sync Mode"
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "image_urls",
          "mask_url",
          "image_size",
          "background",
          "quality",
          "num_images",
          "output_format",
          "output_compression",
          "sync_mode"
        ]
      },
      "ImageSize": {
        "type": "object",
        "title": "ImageSize",
        "properties": {
          "height": {
            "exclusiveMinimum": 0,
            "type": "integer",
            "maximum": 14142,
            "description": "The height of the generated image.",
            "default": 512,
            "title": "Height"
          },
          "width": {
            "exclusiveMinimum": 0,
            "type": "integer",
            "maximum": 14142,
            "description": "The width of the generated image.",
            "default": 512,
            "title": "Width"
          }
        },
        "x-fal-order-properties": [
          "width",
          "height"
        ]
      },
      "GptImage25FlareEditOutput": {
        "type": "object",
        "required": [
          "images"
        ],
        "title": "EditImageResponse",
        "properties": {
          "images": {
            "examples": [
              [
                {
                  "content_type": "image/png",
                  "height": 1024,
                  "width": 1024,
                  "url": "https://v3b.fal.media/files/b/0a8691b0/yUt7tifLSbg1WzWWgfj2o.png",
                  "file_name": "yUt7tifLSbg1WzWWgfj2o.png"
                }
              ]
            ],
            "description": "The generated images.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "title": "Images"
          }
        },
        "x-fal-order-properties": [
          "images"
        ]
      },
      "ImageFile": {
        "type": "object",
        "required": [
          "url"
        ],
        "title": "ImageFile",
        "properties": {
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "height": {
            "description": "The height of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "width": {
            "description": "The width of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ]
      }
    }
  },
  "pricingText": "Text tokens (per 1M): **$5.00** input, **$1.25** cached, **$10.00** output.\nImage tokens (per 1M): **$8.00** input, **$2.00** cached, **$30.00** output. Changing the **quality** parameter significantly affects cost; by default we use **high**. Adjust it to your preference.\nSee the description at the bottom of this page for more details on how much canonical image sizes cost. Total cost is rounded up to the closest hundredth of a cent ($0.0001).\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
