{
  "endpoint": "google/gemini-omni-flash",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=google/gemini-omni-flash",
    "pricing": "https://fal.ai/models/google/gemini-omni-flash/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/GeminiOmniFlashInput"
  },
  "output": {
    "$ref": "#/components/schemas/GeminiOmniFlashOutput"
  },
  "components": {
    "schemas": {
      "GeminiOmniFlashInput": {
        "title": "OmniFlashTextToVideoInput",
        "type": "object",
        "properties": {
          "aspect_ratio": {
            "default": "16:9",
            "enum": [
              "16:9",
              "9:16"
            ],
            "title": "Aspect Ratio",
            "type": "string",
            "description": "The aspect ratio of the generated video."
          },
          "prompt": {
            "maxLength": 20000,
            "title": "Prompt",
            "type": "string",
            "description": "The text prompt describing the video you want to generate.",
            "examples": [
              "A cinematic wide shot of a lighthouse on a rocky cliff at dusk, waves crashing below, the beam slowly sweeping across the dark sea."
            ]
          },
          "duration": {
            "maximum": 10,
            "minimum": 3,
            "default": 8,
            "title": "Duration",
            "type": "integer",
            "description": "The duration of the generated video, in seconds."
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "aspect_ratio",
          "duration"
        ],
        "required": [
          "prompt"
        ]
      },
      "GeminiOmniFlashOutput": {
        "title": "OmniFlashTextToVideoOutput",
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video."
          }
        },
        "x-fal-order-properties": [
          "video"
        ],
        "required": [
          "video"
        ]
      },
      "File": {
        "title": "File",
        "type": "object",
        "properties": {
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes."
          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file."
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "required": [
          "url"
        ]
      }
    }
  },
  "pricingText": "Billing is based on **total token consumption**. Tokens cost **$21.875 per 1 million tokens**. For 720p video this costs **approximately $0.125 per second of video**. \n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
