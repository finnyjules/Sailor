{
  "endpoint": "ideogram/v4",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=ideogram/v4",
    "pricing": "https://fal.ai/models/ideogram/v4/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/V4Input"
  },
  "output": {
    "$ref": "#/components/schemas/V4Output"
  },
  "components": {
    "schemas": {
      "V4Input": {
        "properties": {
          "image_size": {
            "description": "The resolution of the generated image.",
            "title": "Image Size",
            "default": "square_hd",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ],
                "type": "string"
              }
            ],
            "x-fal": {
              "multiple_of": 16,
              "min_height": 512,
              "max_height": 3840,
              "max_width": 3840,
              "min_width": 512
            }
          },
          "num_images": {
            "minimum": 1,
            "maximum": 4,
            "type": "integer",
            "description": "Number of images to generate.",
            "title": "Number of Images",
            "default": 1
          },
          "prompt": {
            "type": "string",
            "description": "The prompt to generate an image from.",
            "title": "Prompt",
            "examples": [
              "A red panda perched on a mossy branch in a misty forest at sunrise"
            ]
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "The seed to use for generation. If not provided, a random seed will be used."
          },
          "sync_mode": {
            "default": false,
            "type": "boolean",
            "description": "If `True`, the image is returned as a data URI and is not stored.",
            "title": "Sync Mode"
          },
          "acceleration": {
            "enum": [
              "none",
              "low",
              "regular",
              "high"
            ],
            "default": "none",
            "type": "string",
            "description": "The acceleration level to use for the image generation.",
            "title": "Acceleration",
            "examples": [
              "none"
            ]
          },
          "rendering_speed": {
            "enum": [
              "TURBO",
              "BALANCED",
              "QUALITY"
            ],
            "default": "BALANCED",
            "type": "string",
            "description": "The rendering speed to use. Faster speeds use fewer denoising steps.",
            "title": "Rendering Speed"
          },
          "output_format": {
            "enum": [
              "jpeg",
              "png"
            ],
            "default": "jpeg",
            "type": "string",
            "description": "The format of the generated image.",
            "title": "Output Format"
          },
          "enable_safety_checker": {
            "default": true,
            "type": "boolean",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "title": "Enable Safety Checker"
          },
          "expansion_model": {
            "enum": [
              "None",
              "Medium",
              "Large"
            ],
            "examples": [
              "Large"
            ],
            "default": "Medium",
            "type": "string",
            "description": "Which model expands the prompt. 'None' disables prompt expansion and skips its fee; 'Medium' is fast; 'Large' uses Ideogram's Magic Prompt for the highest quality.",
            "title": "Expansion Model"
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "expansion_model",
          "image_size",
          "rendering_speed",
          "acceleration",
          "num_images",
          "seed",
          "sync_mode",
          "enable_safety_checker",
          "output_format"
        ],
        "type": "object",
        "title": "TextToImageInput",
        "required": [
          "prompt"
        ]
      },
      "ImageSize": {
        "properties": {
          "height": {
            "default": 512,
            "maximum": 14142,
            "type": "integer",
            "description": "The height of the generated image.",
            "exclusiveMinimum": 0,
            "title": "Height"
          },
          "width": {
            "default": 512,
            "maximum": 14142,
            "type": "integer",
            "description": "The width of the generated image.",
            "exclusiveMinimum": 0,
            "title": "Width"
          }
        },
        "type": "object",
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ]
      },
      "V4Output": {
        "properties": {
          "seed": {
            "type": "integer",
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "title": "Seed"
          },
          "timings": {
            "type": "object",
            "title": "Timings",
            "additionalProperties": {
              "type": "number"
            }
          },
          "has_nsfw_concepts": {
            "items": {
              "type": "boolean"
            },
            "type": "array",
            "description": "Whether the generated images contain NSFW concepts.",
            "title": "Has Nsfw Concepts"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "type": "array",
            "description": "The generated images.",
            "title": "Images",
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a9c92b2/JLDtkHeeec2BL7ZX3PyvI_KzumHcSa.jpg"
                }
              ]
            ]
          },
          "prompt": {
            "type": "string",
            "description": "The prompt used for generating the image.",
            "title": "Prompt"
          }
        },
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object",
        "title": "IdeogramV4Output",
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ]
      },
      "ImageFile": {
        "properties": {
          "content_type": {
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file."
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the image"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the image"
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes."
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "type": "object",
        "title": "ImageFile",
        "required": [
          "url"
        ]
      }
    }
  },
  "pricingText": "Your request will cost **$0.0075** per megapixel in **TURBO** mode, **$0.015** per megapixel in **BALANCED** mode, or **$0.025** per megapixel in **QUALITY** mode. For example, a 2048 x 2048 image will cost **$0.03**, **$0.06** or **$0.10** based on the mode.\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
