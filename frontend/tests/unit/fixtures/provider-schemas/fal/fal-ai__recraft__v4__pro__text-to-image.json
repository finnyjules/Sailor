{
  "endpoint": "fal-ai/recraft/v4/pro/text-to-image",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/recraft/v4/pro/text-to-image",
    "pricing": "https://fal.ai/models/fal-ai/recraft/v4/pro/text-to-image/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/RecraftV4ProTextToImageInput"
  },
  "output": {
    "$ref": "#/components/schemas/RecraftV4ProTextToImageOutput"
  },
  "components": {
    "schemas": {
      "RecraftV4ProTextToImageInput": {
        "properties": {
          "colors": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/RGBColor"
            },
            "description": "An array of preferable colors",
            "type": "array",
            "title": "Colors"
          },
          "background_color": {
            "description": "The preferable background color of the generated images.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/RGBColor"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string",
            "examples": [
              "Crash zoom frozen at the moment of impact as a kingfisher breaks the surface of a pond, water crown splash forming a perfect circle, the bird's beak piercing the mirror-like surface, fish visible just below, frozen at 1/8000s, 400mm super telephoto with 2x extender, ring flash fill, pre-dawn blue light with single shaft of gold, BBC Frozen Planet production quality"
            ],
            "title": "Prompt"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "type": "boolean",
            "title": "Enable Safety Checker"
          },
          "image_size": {
            "default": "square_hd",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "examples": [
              "landscape_16_9"
            ],
            "title": "Image Size"
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "colors",
          "background_color",
          "enable_safety_checker"
        ],
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "RecraftV4ProTextToImageInput"
      },
      "RGBColor": {
        "properties": {
          "r": {
            "default": 0,
            "description": "Red color value",
            "minimum": 0,
            "maximum": 255,
            "type": "integer",
            "title": "R"
          },
          "g": {
            "default": 0,
            "description": "Green color value",
            "minimum": 0,
            "maximum": 255,
            "type": "integer",
            "title": "G"
          },
          "b": {
            "default": 0,
            "description": "Blue color value",
            "minimum": 0,
            "maximum": 255,
            "type": "integer",
            "title": "B"
          }
        },
        "x-fal-order-properties": [
          "r",
          "g",
          "b"
        ],
        "type": "object",
        "title": "RGBColor"
      },
      "ImageSize": {
        "properties": {
          "width": {
            "default": 512,
            "description": "The width of the generated image.",
            "maximum": 14142,
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Width"
          },
          "height": {
            "default": 512,
            "description": "The height of the generated image.",
            "maximum": 14142,
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Height"
          }
        },
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "type": "object",
        "title": "ImageSize"
      },
      "RecraftV4ProTextToImageOutput": {
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "type": "array",
            "examples": [
              [
                {
                  "file_size": 1949504,
                  "content_type": "image/webp",
                  "file_name": "image.webp",
                  "url": "https://storage.googleapis.com/falserverless/example_outputs/recraft-v4/pro-output.webp"
                }
              ]
            ],
            "title": "Images"
          }
        },
        "x-fal-order-properties": [
          "images"
        ],
        "type": "object",
        "required": [
          "images"
        ],
        "title": "RecraftV4ProTextToImageOutput"
      },
      "File": {
        "properties": {
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "type": "object",
        "required": [
          "url"
        ],
        "title": "File"
      }
    }
  },
  "pricingText": "- **Price**: $0.25 per images\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
