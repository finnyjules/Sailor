{
  "endpoint": "fal-ai/flux-pro/kontext",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/flux-pro/kontext",
    "pricing": "https://fal.ai/models/fal-ai/flux-pro/kontext/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/FluxProKontextInput"
  },
  "output": {
    "$ref": "#/components/schemas/FluxProKontextOutput"
  },
  "components": {
    "schemas": {
      "FluxProKontextInput": {
        "required": [
          "prompt",
          "image_url"
        ],
        "properties": {
          "prompt": {
            "examples": [
              "Put a donut next to the flour."
            ],
            "description": "The prompt to generate an image from.",
            "type": "string",
            "title": "Prompt"
          },
          "seed": {
            "title": "Seed",
            "description": "\n            The same seed and the same prompt given to the same version of the model\n            will output the same image every time.\n        ",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "aspect_ratio": {
            "title": "Aspect Ratio",
            "description": "The aspect ratio of the generated image.",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "21:9",
                  "16:9",
                  "4:3",
                  "3:2",
                  "1:1",
                  "2:3",
                  "3:4",
                  "9:16",
                  "9:21"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "guidance_scale": {
            "title": "Guidance scale (CFG)",
            "description": "\n            The CFG (Classifier Free Guidance) scale is a measure of how close you want\n            the model to stick to your prompt when looking for a related image to show you.\n        ",
            "maximum": 20,
            "default": 3.5,
            "type": "number",
            "minimum": 1
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean",
            "default": false,
            "title": "Sync Mode"
          },
          "output_format": {
            "description": "The format of the generated image.",
            "type": "string",
            "enum": [
              "jpeg",
              "png"
            ],
            "default": "jpeg",
            "title": "Output Format"
          },
          "enhance_prompt": {
            "description": "Whether to enhance the prompt for better results.",
            "type": "boolean",
            "default": false,
            "title": "Enhance Prompt"
          },
          "image_url": {
            "examples": [
              "https://v3.fal.media/files/rabbit/rmgBxhwGYb2d3pl3x9sKf_output.png"
            ],
            "description": "Image prompt for the omni model.",
            "minLength": 1,
            "type": "string",
            "title": "Image URL"
          },
          "safety_tolerance": {
            "default": "2",
            "description": "The safety tolerance level for the generated image. 1 being the most strict and 5 being the most permissive.",
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            "title": "Safety Tolerance"
          },
          "num_images": {
            "title": "Num Images",
            "description": "The number of images to generate.",
            "maximum": 4,
            "default": 1,
            "type": "integer",
            "minimum": 1
          }
        },
        "title": "FluxKontextInput",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "seed",
          "guidance_scale",
          "sync_mode",
          "num_images",
          "output_format",
          "safety_tolerance",
          "enhance_prompt",
          "aspect_ratio",
          "image_url"
        ]
      },
      "FluxProKontextOutput": {
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "seed": {
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "type": "integer",
            "title": "Seed"
          },
          "timings": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/fal__toolkit__image__image__Image"
            },
            "examples": [
              [
                {
                  "url": "https://fal.media/files/tiger/7dSJbIU_Ni-0Zp9eaLsvR_fe56916811d84ac69c6ffc0d32dca151.jpg",
                  "height": 1024,
                  "width": 1024
                }
              ]
            ],
            "description": "The generated image files info.",
            "type": "array",
            "title": "Images"
          },
          "prompt": {
            "description": "The prompt used for generating the image.",
            "type": "string",
            "title": "Prompt"
          },
          "has_nsfw_concepts": {
            "items": {
              "type": "boolean"
            },
            "description": "Whether the generated images contain NSFW concepts.",
            "type": "array",
            "title": "Has Nsfw Concepts"
          }
        },
        "title": "FluxKontextOutput",
        "type": "object",
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ]
      },
      "fal__toolkit__image__image__Image": {
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "file_size": {
            "title": "File Size",
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_name": {
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "title": "Content Type",
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "title": "Height",
            "examples": [
              1024
            ],
            "description": "The height of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "title": "Width",
            "examples": [
              1024
            ],
            "description": "The width of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "Image",
        "description": "Represents an image file.",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ]
      }
    }
  },
  "pricingText": "- **Price**: $0.04 per images\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
