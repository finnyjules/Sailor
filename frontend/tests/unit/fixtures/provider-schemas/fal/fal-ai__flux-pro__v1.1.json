{
  "endpoint": "fal-ai/flux-pro/v1.1",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/flux-pro/v1.1",
    "pricing": "https://fal.ai/models/fal-ai/flux-pro/v1.1/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/FluxProV11Input"
  },
  "output": {
    "$ref": "#/components/schemas/FluxProV11Output"
  },
  "components": {
    "schemas": {
      "FluxProV11Input": {
        "required": [
          "prompt"
        ],
        "properties": {
          "image_size": {
            "title": "Image Size",
            "description": "The size of the generated image.",
            "default": "landscape_4_3",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ]
          },
          "seed": {
            "title": "Seed",
            "description": "\n            The same seed and the same prompt given to the same version of the model\n            will output the same image every time.\n        ",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean",
            "default": false,
            "title": "Sync Mode"
          },
          "output_format": {
            "description": "The format of the generated image.",
            "type": "string",
            "enum": [
              "jpeg",
              "png"
            ],
            "default": "jpeg",
            "title": "Output Format"
          },
          "enhance_prompt": {
            "description": "Whether to enhance the prompt for better results.",
            "type": "boolean",
            "default": false,
            "title": "Enhance Prompt"
          },
          "prompt": {
            "examples": [
              "Extreme close-up of a single tiger eye, direct frontal view. Detailed iris and pupil. Sharp focus on eye texture and color. Natural lighting to capture authentic eye shine and depth. The word \"FLUX\" is painted over it in big, white brush strokes with visible texture."
            ],
            "description": "The prompt to generate an image from.",
            "type": "string",
            "title": "Prompt"
          },
          "safety_tolerance": {
            "default": "2",
            "description": "The safety tolerance level for the generated image. 1 being the most strict and 5 being the most permissive.",
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            "title": "Safety Tolerance"
          },
          "num_images": {
            "title": "Num Images",
            "description": "The number of images to generate.",
            "maximum": 4,
            "default": 1,
            "type": "integer",
            "minimum": 1
          }
        },
        "title": "FluxProPlusTextToImageInput",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "seed",
          "sync_mode",
          "num_images",
          "output_format",
          "safety_tolerance",
          "enhance_prompt"
        ]
      },
      "ImageSize": {
        "title": "ImageSize",
        "properties": {
          "height": {
            "description": "The height of the generated image.",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "default": 512,
            "type": "integer",
            "title": "Height"
          },
          "width": {
            "description": "The width of the generated image.",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "default": 512,
            "type": "integer",
            "title": "Width"
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "width",
          "height"
        ]
      },
      "FluxProV11Output": {
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "seed": {
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "type": "integer",
            "title": "Seed"
          },
          "timings": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/registry__image__fast_sdxl__models__Image"
            },
            "description": "The generated image files info.",
            "type": "array",
            "title": "Images"
          },
          "prompt": {
            "description": "The prompt used for generating the image.",
            "type": "string",
            "title": "Prompt"
          },
          "has_nsfw_concepts": {
            "items": {
              "type": "boolean"
            },
            "description": "Whether the generated images contain NSFW concepts.",
            "type": "array",
            "title": "Has Nsfw Concepts"
          }
        },
        "title": "Output",
        "type": "object",
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ]
      },
      "registry__image__fast_sdxl__models__Image": {
        "required": [
          "url",
          "width",
          "height"
        ],
        "properties": {
          "content_type": {
            "title": "Content Type",
            "default": "image/jpeg",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          }
        },
        "title": "Image",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "width",
          "height",
          "content_type"
        ]
      }
    }
  },
  "pricingText": "- **Price**: $0.04 per megapixels\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
