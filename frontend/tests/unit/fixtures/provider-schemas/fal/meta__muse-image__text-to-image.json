{
  "endpoint": "meta/muse-image/text-to-image",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=meta/muse-image/text-to-image",
    "pricing": "https://fal.ai/models/meta/muse-image/text-to-image/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/MuseImageTextToImageInput"
  },
  "output": {
    "$ref": "#/components/schemas/MuseImageTextToImageOutput"
  },
  "components": {
    "schemas": {
      "MuseImageTextToImageInput": {
        "title": "MuseImageInput",
        "type": "object",
        "properties": {
          "sync_mode": {
            "default": false,
            "title": "Sync Mode",
            "type": "boolean",
            "description": "If `True`, the image is returned as a data URI and is not persisted in the request history."
          },
          "aspect_ratio": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,4}:[1-9][0-9]{0,4}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aspect Ratio",
            "examples": [
              "16:9"
            ],
            "description": "Any custom output aspect ratio as \"width:height\", for example \"16:9\", \"5:4\", or \"1920:1200\". Common presets are \"21:9\", \"16:9\", \"4:3\", \"3:2\", \"1:1\", \"2:3\", \"3:4\", \"9:16\", \"9:21\". The ratio must be between 1:16 and 16:1, the range Muse supports. Only the ratio is used: Muse renders it at its own fixed resolution of roughly 2.5 megapixels, so \"1920:1200\" and \"960:600\" both return the same 1920x1200 image. If omitted, Muse chooses the output dimensions automatically."
          },
          "prompt": {
            "minLength": 1,
            "title": "Prompt",
            "type": "string",
            "examples": [
              "A cinematic editorial portrait in soft window light with crisp typography"
            ],
            "description": "The text prompt used to generate or edit the image."
          },
          "num_images": {
            "maximum": 10,
            "minimum": 1,
            "default": 1,
            "title": "Num Images",
            "type": "integer",
            "description": "The number of images to generate."
          },
          "output_format": {
            "default": "webp",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "title": "Output Format",
            "type": "string",
            "description": "The format of the generated image."
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "aspect_ratio",
          "num_images",
          "output_format",
          "sync_mode"
        ],
        "required": [
          "prompt"
        ]
      },
      "MuseImageTextToImageOutput": {
        "title": "MuseImageOutput",
        "type": "object",
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "title": "Images",
            "type": "array",
            "description": "The generated or edited images."
          }
        },
        "x-fal-order-properties": [
          "images"
        ],
        "required": [
          "images"
        ]
      },
      "Image": {
        "description": "Represents an image file.",
        "title": "Image",
        "properties": {
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes."
          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "examples": [
              1024
            ],
            "description": "The width of the image in pixels."
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file."
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "examples": [
              1024
            ],
            "description": "The height of the image in pixels."
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "required": [
          "url"
        ]
      }
    }
  },
  "pricingText": "- **Price**: $0.01 per images\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
