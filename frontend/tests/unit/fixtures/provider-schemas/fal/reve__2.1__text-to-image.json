{
  "endpoint": "reve/2.1/text-to-image",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=reve/2.1/text-to-image",
    "pricing": "https://fal.ai/models/reve/2.1/text-to-image/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/21TextToImageInput"
  },
  "output": {
    "$ref": "#/components/schemas/21TextToImageOutput"
  },
  "components": {
    "schemas": {
      "21TextToImageInput": {
        "description": "Input for Reve Image 2 (v2) text-to-image generation",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "aspect_ratio",
          "num_images",
          "output_format",
          "sync_mode"
        ],
        "properties": {
          "aspect_ratio": {
            "description": "The desired aspect ratio of the generated image. With `auto`, the model picks an appropriate aspect ratio for the request.",
            "type": "string",
            "title": "Aspect Ratio",
            "examples": [
              "16:9"
            ],
            "enum": [
              "4:1",
              "3:1",
              "21:9",
              "2:1",
              "17:9",
              "16:9",
              "3:2",
              "4:3",
              "5:4",
              "1:1",
              "4:5",
              "3:4",
              "2:3",
              "9:16",
              "1:2",
              "1:3",
              "1:4",
              "auto"
            ],
            "default": "auto"
          },
          "prompt": {
            "maxLength": 4000,
            "type": "string",
            "title": "Prompt",
            "examples": [
              "A towering stack of golden fluffy pancakes drizzled with amber honey syrup, topped with fresh blackberries and sliced bananas, served on a white ceramic plate on a rustic wooden table with a soft blue-gray background."
            ],
            "description": "The text description of the desired image.",
            "minLength": 1
          },
          "num_images": {
            "description": "Number of images to generate",
            "type": "integer",
            "examples": [
              1
            ],
            "maximum": 4,
            "minimum": 1,
            "default": 1,
            "title": "Number of Images"
          },
          "output_format": {
            "description": "Output format for the generated image.",
            "type": "string",
            "title": "Output Format",
            "examples": [
              "png"
            ],
            "enum": [
              "png",
              "jpeg",
              "webp"
            ],
            "default": "png"
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean",
            "title": "Sync Mode",
            "default": false
          }
        },
        "title": "ReveImage2CreateInput",
        "required": [
          "prompt"
        ]
      },
      "21TextToImageOutput": {
        "description": "Output for Reve Image 2 (v2) text-to-image generation",
        "type": "object",
        "x-fal-order-properties": [
          "images"
        ],
        "properties": {
          "images": {
            "description": "The generated images",
            "type": "array",
            "title": "Images",
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/panda/-WnGcaJCtfrT6Q2oms97E.png"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          }
        },
        "title": "ReveImage2CreateOutput",
        "required": [
          "images"
        ]
      },
      "Image": {
        "description": "Represents an image file.",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "description": "The height of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "examples": [
              1024
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "width": {
            "description": "The width of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "examples": [
              1024
            ]
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ]
          }
        },
        "title": "Image",
        "required": [
          "url"
        ]
      }
    }
  },
  "pricingText": "- **Price**: $0.25 per images\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
