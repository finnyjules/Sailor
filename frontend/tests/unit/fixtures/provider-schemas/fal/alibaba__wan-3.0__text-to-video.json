{
  "endpoint": "alibaba/wan-3.0/text-to-video",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=alibaba/wan-3.0/text-to-video",
    "pricing": "https://fal.ai/models/alibaba/wan-3.0/text-to-video/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/Wan30TextToVideoInput"
  },
  "output": {
    "$ref": "#/components/schemas/Wan30TextToVideoOutput"
  },
  "components": {
    "schemas": {
      "Wan30TextToVideoInput": {
        "title": "Wan30TextToVideoInput",
        "x-fal-order-properties": [
          "prompt",
          "resolution",
          "aspect_ratio",
          "duration",
          "audio",
          "enable_prompt_expansion",
          "enable_thinking",
          "seed",
          "enable_safety_checker"
        ],
        "type": "object",
        "properties": {
          "prompt": {
            "title": "Prompt",
            "examples": [
              "A red panda walking through a bamboo forest at sunrise"
            ],
            "description": "Text prompt for the generated video.",
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "enable_thinking": {
            "title": "Enable Thinking",
            "type": "boolean",
            "default": false,
            "description": "Enable enhanced reasoning before generation."
          },
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "default": true,
            "type": "boolean",
            "description": "Enable content moderation for input and output. Disabling it requires account authorization; unauthorized requests are always checked."
          },
          "audio": {
            "title": "Audio",
            "type": "boolean",
            "default": true,
            "description": "Include generated audio."
          },
          "aspect_ratio": {
            "title": "Aspect Ratio",
            "enum": [
              "adaptive",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ],
            "type": "string",
            "default": "adaptive",
            "description": "Output aspect ratio, or adaptive selection."
          },
          "duration": {
            "anyOf": [
              {
                "maximum": 30,
                "type": "integer",
                "minimum": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration",
            "default": 5,
            "description": "Output duration in seconds. Set to null for smart duration, which lets the model pick a length from the prompt and reference media."
          },
          "seed": {
            "anyOf": [
              {
                "maximum": 2147483647,
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "resolution": {
            "title": "Resolution",
            "enum": [
              "480p",
              "720p",
              "1080p"
            ],
            "type": "string",
            "default": "1080p",
            "description": "Output video resolution tier."
          },
          "enable_prompt_expansion": {
            "title": "Enable Prompt Expansion",
            "default": true,
            "type": "boolean",
            "description": "Enable intelligent prompt rewriting. Disabling it can save roughly 20-60 seconds of latency but is likely to degrade generation quality."
          }
        },
        "required": [
          "prompt"
        ]
      },
      "Wan30TextToVideoOutput": {
        "title": "Wan30Output",
        "x-fal-order-properties": [
          "video",
          "seed",
          "duration",
          "actual_prompt"
        ],
        "type": "object",
        "properties": {
          "duration": {
            "title": "Duration",
            "type": "number",
            "description": "Generated video duration in seconds."
          },
          "actual_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Prompt"
          },
          "video": {
            "description": "The generated video file.",
            "$ref": "#/components/schemas/VideoFile"
          },
          "seed": {
            "title": "Seed",
            "type": "integer",
            "description": "The seed used for generation."
          }
        },
        "required": [
          "video",
          "seed",
          "duration"
        ]
      },
      "VideoFile": {
        "title": "VideoFile",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height",
          "fps",
          "duration",
          "num_frames"
        ],
        "type": "object",
        "properties": {
          "num_frames": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Num Frames",
            "description": "The number of frames in the video"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size"
          },
          "fps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fps",
            "description": "The FPS of the video"
          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the video"
          },
          "duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration",
            "description": "The duration of the video"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the video"
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  },
  "pricingText": "For every second of video you generate, you will be charged **$0.05** **480p**, **$0.10** **720p**, or **$0.20** **1080p**. For example, a **5s** video at **720p** will cost **$0.50**. **Pricing is subjected to change.***\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
