{
  "endpoint": "krea/v2/large/text-to-image",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=krea/v2/large/text-to-image",
    "pricing": "https://fal.ai/models/krea/v2/large/text-to-image/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/V2LargeTextToImageInput"
  },
  "output": {
    "$ref": "#/components/schemas/V2LargeTextToImageOutput"
  },
  "components": {
    "schemas": {
      "V2LargeTextToImageInput": {
        "x-fal-order-properties": [
          "prompt",
          "aspect_ratio",
          "creativity",
          "seed",
          "image_style_references",
          "styles",
          "moodboards"
        ],
        "properties": {
          "creativity": {
            "enum": [
              "raw",
              "low",
              "medium",
              "high"
            ],
            "default": "medium",
            "type": "string",
            "description": "Controls how loosely the model interprets the prompt. Higher values produce more creative results that may drift from the prompt; lower values stay closer to the prompt.",
            "title": "Creativity"
          },
          "styles": {
            "maxItems": 10,
            "default": [],
            "type": "array",
            "description": "Optional list of Krea preset styles (LoRA-based) to apply. Each entry references a style by `id` from the Krea styles catalog. At most 10 entries.",
            "items": {
              "$ref": "#/components/schemas/Style"
            },
            "title": "Styles"
          },
          "aspect_ratio": {
            "enum": [
              "1:1",
              "4:3",
              "3:2",
              "16:9",
              "2.35:1",
              "4:5",
              "2:3",
              "9:16"
            ],
            "default": "1:1",
            "type": "string",
            "description": "Aspect ratio of the generated image.",
            "title": "Aspect Ratio",
            "examples": [
              "1:1"
            ]
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "Random seed for reproducible generation."
          },
          "moodboards": {
            "maxItems": 1,
            "default": [],
            "type": "array",
            "description": "Optional moodboard to apply to the generation. Krea currently accepts at most one moodboard per request. Each entry references a moodboard by `id` (UUID).",
            "items": {
              "$ref": "#/components/schemas/Moodboard"
            },
            "title": "Moodboards"
          },
          "prompt": {
            "examples": [
              "A Van Gogh-tinged Provençal farmhouse under starry nights."
            ],
            "minLength": 1,
            "type": "string",
            "description": "Text description of the image to generate.",
            "title": "Prompt",
            "maxLength": 5000
          },
          "image_style_references": {
            "maxItems": 10,
            "default": [],
            "type": "array",
            "description": "Optional list of reference images that guide the style of the generated image. At most 10 entries.",
            "items": {
              "$ref": "#/components/schemas/ImageStyleReference"
            },
            "title": "Image Style References"
          }
        },
        "type": "object",
        "description": "Input for Krea-2 Large image generation.",
        "required": [
          "prompt"
        ],
        "title": "Krea2LargeInput"
      },
      "Style": {
        "x-fal-order-properties": [
          "id",
          "strength"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Krea style identifier (a LoRA-based preset style) returned by the Krea styles catalog.",
            "title": "Id"
          },
          "strength": {
            "maximum": 2,
            "default": 1,
            "type": "number",
            "description": "How strongly the style influences the generated image. Negative values push away from the style.",
            "title": "Strength",
            "minimum": -2
          }
        },
        "type": "object",
        "title": "Style",
        "required": [
          "id"
        ]
      },
      "Moodboard": {
        "x-fal-order-properties": [
          "id",
          "strength"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Krea moodboard identifier (UUID).",
            "title": "Id"
          },
          "strength": {
            "maximum": 1,
            "default": 0.23,
            "type": "number",
            "description": "How strongly the moodboard influences the generated image.",
            "title": "Strength",
            "minimum": 0
          }
        },
        "type": "object",
        "title": "Moodboard",
        "required": [
          "id"
        ]
      },
      "ImageStyleReference": {
        "x-fal-order-properties": [
          "image_url",
          "strength"
        ],
        "properties": {
          "image_url": {
            "type": "string",
            "description": "Publicly accessible URL of a reference image.",
            "title": "Image Url"
          },
          "strength": {
            "maximum": 2,
            "default": 1,
            "type": "number",
            "description": "How strongly the reference influences the generated image. Negative values push away from the reference.",
            "title": "Strength",
            "minimum": -2
          }
        },
        "type": "object",
        "title": "ImageStyleReference",
        "required": [
          "image_url"
        ]
      },
      "V2LargeTextToImageOutput": {
        "x-fal-order-properties": [
          "images",
          "seed"
        ],
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array",
            "description": "The generated images.",
            "title": "Images",
            "examples": [
              [
                {
                  "url": "https://v3.fal.media/files/panda/krea_v2_example.png"
                }
              ]
            ]
          },
          "seed": {
            "type": "integer",
            "description": "The seed used to generate the image.",
            "title": "Seed",
            "examples": [
              12345
            ]
          }
        },
        "type": "object",
        "title": "Krea2Output",
        "required": [
          "images",
          "seed"
        ]
      },
      "Image": {
        "description": "Represents an image file.",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the image in pixels.",
            "examples": [
              1024
            ]
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ]
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ]
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the image in pixels.",
            "examples": [
              1024
            ]
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "Image"
      }
    }
  },
  "pricingText": "For every image you generate, you will be charged **$0.060** (text-to-image) or **$0.065** (using image_style_references).\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
