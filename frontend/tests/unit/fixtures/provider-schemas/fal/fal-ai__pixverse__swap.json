{
  "endpoint": "fal-ai/pixverse/swap",
  "fetchedAt": "2026-09-27",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/pixverse/swap",
    "pricing": "https://fal.ai/models/fal-ai/pixverse/swap/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/PixverseSwapInput"
  },
  "output": {
    "$ref": "#/components/schemas/PixverseSwapOutput"
  },
  "components": {
    "schemas": {
      "PixverseSwapInput": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "person",
              "object",
              "background"
            ],
            "title": "Mode",
            "description": "The swap mode to use",
            "default": "person"
          },
          "video_url": {
            "examples": [
              "https://v3b.fal.media/files/b/lion/k_RpEIZ4YZtwZklzXz7Gb_output.mp4"
            ],
            "type": "string",
            "title": "Video Url",
            "description": "URL of the external video to swap"
          },
          "image_url": {
            "examples": [
              "https://v3b.fal.media/files/b/elephant/Lu7lo2dpxVPD-NrNZzx42_56dc797a1f764c98a4f075a8c0332bf0.jpg"
            ],
            "type": "string",
            "title": "Image Url",
            "description": "URL of the target image for swapping"
          },
          "keyframe_id": {
            "type": "integer",
            "title": "Keyframe Id",
            "description": "The keyframe ID to use for face/object mapping. The input video is normalized to 24 FPS before processing, so keyframe 1 = first frame, keyframe 24 = 1 second in, etc. Valid range: 1 to (duration_seconds * 24).",
            "minimum": 1,
            "default": 1
          },
          "resolution": {
            "type": "string",
            "enum": [
              "360p",
              "540p",
              "720p"
            ],
            "title": "Resolution",
            "description": "The output resolution (1080p not supported)",
            "default": "720p"
          },
          "original_sound_switch": {
            "type": "boolean",
            "title": "Original Sound Switch",
            "description": "Whether to keep the original audio",
            "default": true
          },
          "seed": {
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed for generation"
          }
        },
        "title": "SwapRequest",
        "required": [
          "video_url",
          "image_url"
        ],
        "x-fal-order-properties": [
          "video_url",
          "mode",
          "keyframe_id",
          "image_url",
          "resolution",
          "seed",
          "original_sound_switch"
        ]
      },
      "PixverseSwapOutput": {
        "type": "object",
        "properties": {
          "video": {
            "examples": [
              {
                "file_name": "output.mp4",
                "file_size": 1234567,
                "url": "https://v3b.fal.media/files/b/elephant/BdQvPf9T6puy3Co1_ZXeu_output.mp4",
                "content_type": "video/mp4"
              }
            ],
            "$ref": "#/components/schemas/File",
            "description": "The generated swapped video"
          }
        },
        "title": "SwapOutput",
        "required": [
          "video"
        ],
        "x-fal-order-properties": [
          "video"
        ]
      },
      "File": {
        "type": "object",
        "properties": {
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes."
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "The URL where the file can be downloaded from."
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file."
          }
        },
        "title": "File",
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      }
    }
  },
  "pricingText": "For 5s video your request will cost **$0.15** for 360p and 540p, **$0.2** for 720p and **$0.4** for 1080p. If input video duration is greater than 5 s the cost will double. For **$1** you can run this model with approximately 2 times.\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
