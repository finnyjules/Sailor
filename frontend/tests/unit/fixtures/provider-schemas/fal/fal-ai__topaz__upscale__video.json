{
  "endpoint": "fal-ai/topaz/upscale/video",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/topaz/upscale/video",
    "pricing": "https://fal.ai/models/fal-ai/topaz/upscale/video/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/TopazUpscaleVideoInput"
  },
  "output": {
    "$ref": "#/components/schemas/TopazUpscaleVideoOutput"
  },
  "components": {
    "schemas": {
      "TopazUpscaleVideoInput": {
        "type": "object",
        "properties": {
          "grain": {
            "description": "Film grain amount (0.0-0.1). Default varies by model.",
            "title": "Grain",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 0.1,
                "multipleOf": 0.01
              },
              {
                "type": "null"
              }
            ]
          },
          "video_url": {
            "type": "string",
            "description": "URL of the video to upscale",
            "examples": [
              "https://v3.fal.media/files/kangaroo/y5-1YTGpun17eSeggZMzX_video-1733468228.mp4"
            ],
            "title": "Video Url"
          },
          "target_fps": {
            "description": "Target FPS for frame interpolation. If set, frame interpolation will be enabled.",
            "title": "Target Fps",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 16,
                "maximum": 60
              },
              {
                "type": "null"
              }
            ]
          },
          "halo": {
            "description": "Halo reduction level (0.0-1.0). Default varies by model.",
            "title": "Halo",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "recover_detail": {
            "description": "Recover original detail level (0.0-1.0). Higher values preserve more original detail.",
            "title": "Recover Detail",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "noise": {
            "description": "Noise reduction level (0.0-1.0). Default varies by model.",
            "title": "Noise",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "upscale_factor": {
            "type": "number",
            "minimum": 1,
            "description": "Factor to upscale the video by (e.g. 2.0 doubles width and height)",
            "maximum": 4,
            "default": 2,
            "title": "Upscale Factor"
          },
          "model": {
            "enum": [
              "Proteus",
              "Artemis HQ",
              "Artemis MQ",
              "Artemis LQ",
              "Gaia HQ",
              "Gaia CG",
              "Gaia 2",
              "Nyx",
              "Nyx Fast",
              "Nyx XL",
              "Nyx HF",
              "Starlight Precise 2.5",
              "Starlight HQ",
              "Starlight Mini",
              "Starlight Sharp",
              "Starlight Fast 2",
              "Starlight Precise 1",
              "Starlight Precise 2",
              "Starlight Fast 1"
            ],
            "type": "string",
            "description": "Video enhancement model, grouped by family. Precision — Proteus fits most footage, Artemis denoises and sharpens degraded sources, Gaia HQ/CG refine rendered content, Gaia 2 handles animation and motion graphics at 2x. Denoise — Nyx models are dedicated noise reduction. Generative — Starlight models use diffusion for restoration and upscaling. Starlight Precise 1, Starlight Precise 2 and Starlight Fast 1 are deprecated by Topaz; prefer Starlight Precise 2.5 or Starlight Fast 2.",
            "title": "Model",
            "default": "Proteus"
          },
          "H264_output": {
            "type": "boolean",
            "description": "Whether to use H264 codec for output video. Default is H265.",
            "title": "H264 Output",
            "default": false
          },
          "compression": {
            "description": "Compression artifact removal level (0.0-1.0). Default varies by model.",
            "title": "Compression",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "x-fal-order-properties": [
          "video_url",
          "model",
          "upscale_factor",
          "target_fps",
          "compression",
          "noise",
          "halo",
          "grain",
          "recover_detail",
          "H264_output"
        ],
        "title": "VideoUpscaleRequest",
        "required": [
          "video_url"
        ]
      },
      "TopazUpscaleVideoOutput": {
        "type": "object",
        "properties": {
          "video": {
            "description": "The upscaled video file",
            "$ref": "#/components/schemas/File",
            "examples": [
              {
                "url": "https://v3.fal.media/files/penguin/ztj_LB4gQlW6HIfVs8zX4_upscaled.mp4"
              }
            ]
          }
        },
        "x-fal-order-properties": [
          "video"
        ],
        "title": "VideoUpscaleOutput",
        "required": [
          "video"
        ]
      },
      "File": {
        "type": "object",
        "properties": {
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "content_type": {
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "title": "File",
        "required": [
          "url"
        ]
      }
    }
  },
  "pricingText": "For every second a video your request will cost **$0.01** for up to **720p**, **$0.02** for **720p** to **1080p**, and **$0.08** for above **1080p** output. Price doubles for **60fps** output. For **Gaia 2** output costs half of the prices.\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
