{
  "endpoint": "fal-ai/bytedance/seedream/v4/text-to-image",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/bytedance/seedream/v4/text-to-image",
    "pricing": "https://fal.ai/models/fal-ai/bytedance/seedream/v4/text-to-image/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/BytedanceSeedreamV4TextToImageInput"
  },
  "output": {
    "$ref": "#/components/schemas/BytedanceSeedreamV4TextToImageOutput"
  },
  "components": {
    "schemas": {
      "BytedanceSeedreamV4TextToImageInput": {
        "required": [
          "prompt"
        ],
        "properties": {
          "image_size": {
            "title": "Image Size",
            "examples": [
              {
                "height": 4096,
                "width": 4096
              }
            ],
            "description": "The size of the generated image. Total pixels must be between 960x960 and 4096x4096.",
            "default": {
              "height": 2048,
              "width": 2048
            },
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto",
                  "auto_2K",
                  "auto_4K"
                ]
              }
            ]
          },
          "seed": {
            "title": "Seed",
            "description": "Random seed to control the stochasticity of image generation.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "enhance_prompt_mode": {
            "description": "The mode to use for enhancing prompt enhancement. Standard mode provides higher quality results but takes longer to generate. Fast mode provides average quality results but takes less time to generate.",
            "type": "string",
            "enum": [
              "standard",
              "fast"
            ],
            "default": "standard",
            "title": "Enhance Prompt Mode"
          },
          "max_images": {
            "title": "Max Images",
            "description": "If set to a number greater than one, enables multi-image generation. The model will potentially return up to `max_images` images every generation, and in total, `num_images` generations will be carried out. In total, the number of images generated will be between `num_images` and `max_images*num_images`.",
            "maximum": 6,
            "default": 1,
            "type": "integer",
            "minimum": 1
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean",
            "default": false,
            "title": "Sync Mode"
          },
          "num_images": {
            "title": "Num Images",
            "description": "Number of separate model generations to be run with the prompt.",
            "maximum": 6,
            "default": 1,
            "type": "integer",
            "minimum": 1
          },
          "enable_safety_checker": {
            "examples": [
              true
            ],
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "type": "boolean",
            "default": true,
            "title": "Enable Safety Checker"
          },
          "prompt": {
            "examples": [
              "A trendy restaurant with a digital menu board displaying \"Seedream 4.0 is available on fal\" in elegant script, with diners enjoying their meals."
            ],
            "description": "The text prompt used to generate the image",
            "type": "string",
            "title": "Prompt"
          }
        },
        "title": "SeedDream4T2IInput",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "num_images",
          "max_images",
          "seed",
          "sync_mode",
          "enable_safety_checker",
          "enhance_prompt_mode"
        ]
      },
      "ImageSize": {
        "title": "ImageSize",
        "properties": {
          "height": {
            "type": "integer",
            "description": "The height of the generated image.",
            "maximum": 14142,
            "default": 512,
            "exclusiveMinimum": 0,
            "title": "Height"
          },
          "width": {
            "type": "integer",
            "description": "The width of the generated image.",
            "maximum": 14142,
            "default": 512,
            "exclusiveMinimum": 0,
            "title": "Width"
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "width",
          "height"
        ]
      },
      "BytedanceSeedreamV4TextToImageOutput": {
        "required": [
          "images",
          "seed"
        ],
        "properties": {
          "seed": {
            "examples": [
              746406749
            ],
            "description": "Seed used for generation",
            "type": "integer",
            "title": "Seed"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "examples": [
              [
                {
                  "url": "https://storage.googleapis.com/falserverless/example_outputs/seedream4_t2i_output.png"
                }
              ]
            ],
            "description": "Generated images",
            "type": "array",
            "title": "Images"
          }
        },
        "title": "SeedDream4T2IOutput",
        "type": "object",
        "x-fal-order-properties": [
          "images",
          "seed"
        ]
      },
      "Image": {
        "required": [
          "url"
        ],
        "properties": {
          "content_type": {
            "title": "Content Type",
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_size": {
            "title": "File Size",
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_name": {
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "height": {
            "title": "Height",
            "examples": [
              1024
            ],
            "description": "The height of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "title": "Width",
            "examples": [
              1024
            ],
            "description": "The width of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "description": "Represents an image file.",
        "type": "object",
        "title": "Image"
      }
    }
  },
  "pricingText": "- **Price**: $0.03 per images\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
