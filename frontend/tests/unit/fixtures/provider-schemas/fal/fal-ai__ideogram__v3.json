{
  "endpoint": "fal-ai/ideogram/v3",
  "fetchedAt": "2026-09-25",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/ideogram/v3",
    "pricing": "https://fal.ai/models/fal-ai/ideogram/v3/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/IdeogramV3Input"
  },
  "output": {
    "$ref": "#/components/schemas/IdeogramV3Output"
  },
  "components": {
    "schemas": {
      "IdeogramV3Input": {
        "type": "object",
        "title": "BaseTextToImageInputV3",
        "properties": {
          "color_palette": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ColorPalette"
              },
              {
                "type": "null"
              }
            ],
            "description": "A color palette for generation, must EITHER be specified via one of the presets (name) or explicitly via hexadecimal representations of the color with optional weights (members)"
          },
          "prompt": {
            "examples": [
              "The Bone Forest stretched across the horizon, its trees fashioned from the ossified remains of ancient leviathans that once swam through the sky. Shamans with antlers growing from their shoulders and eyes that revealed the true nature of any being they beheld conducted rituals to commune with the spirits that still inhabited the calcified grove. In sky writes \"Ideogram V3 in fal.ai\""
            ],
            "type": "string",
            "title": "Prompt"
          },
          "style_codes": {
            "title": "Style Codes",
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A list of 8 character hexadecimal codes representing the style of the image. Cannot be used in conjunction with style_reference_images or style"
          },
          "style": {
            "title": "Style",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "AUTO",
                  "GENERAL",
                  "REALISTIC",
                  "DESIGN"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "The style type to generate with. Cannot be used with style_codes."
          },
          "image_urls": {
            "title": "Image Urls",
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A set of images to use as style references (maximum total size 10MB across all style references). The images should be in JPEG, PNG or WebP format"
          },
          "style_preset": {
            "title": "Style Preset",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "80S_ILLUSTRATION",
                  "90S_NOSTALGIA",
                  "ABSTRACT_ORGANIC",
                  "ANALOG_NOSTALGIA",
                  "ART_BRUT",
                  "ART_DECO",
                  "ART_POSTER",
                  "AURA",
                  "AVANT_GARDE",
                  "BAUHAUS",
                  "BLUEPRINT",
                  "BLURRY_MOTION",
                  "BRIGHT_ART",
                  "C4D_CARTOON",
                  "CHILDRENS_BOOK",
                  "COLLAGE",
                  "COLORING_BOOK_I",
                  "COLORING_BOOK_II",
                  "CUBISM",
                  "DARK_AURA",
                  "DOODLE",
                  "DOUBLE_EXPOSURE",
                  "DRAMATIC_CINEMA",
                  "EDITORIAL",
                  "EMOTIONAL_MINIMAL",
                  "ETHEREAL_PARTY",
                  "EXPIRED_FILM",
                  "FLAT_ART",
                  "FLAT_VECTOR",
                  "FOREST_REVERIE",
                  "GEO_MINIMALIST",
                  "GLASS_PRISM",
                  "GOLDEN_HOUR",
                  "GRAFFITI_I",
                  "GRAFFITI_II",
                  "HALFTONE_PRINT",
                  "HIGH_CONTRAST",
                  "HIPPIE_ERA",
                  "ICONIC",
                  "JAPANDI_FUSION",
                  "JAZZY",
                  "LONG_EXPOSURE",
                  "MAGAZINE_EDITORIAL",
                  "MINIMAL_ILLUSTRATION",
                  "MIXED_MEDIA",
                  "MONOCHROME",
                  "NIGHTLIFE",
                  "OIL_PAINTING",
                  "OLD_CARTOONS",
                  "PAINT_GESTURE",
                  "POP_ART",
                  "RETRO_ETCHING",
                  "RIVIERA_POP",
                  "SPOTLIGHT_80S",
                  "STYLIZED_RED",
                  "SURREAL_COLLAGE",
                  "TRAVEL_POSTER",
                  "VINTAGE_GEO",
                  "VINTAGE_POSTER",
                  "WATERCOLOR",
                  "WEIRD",
                  "WOODBLOCK_PRINT"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Style preset for generation. The chosen style preset will guide the generation."
          },
          "num_images": {
            "type": "integer",
            "title": "Num Images",
            "maximum": 8,
            "description": "Number of images to generate.",
            "minimum": 1,
            "default": 1
          },
          "rendering_speed": {
            "type": "string",
            "enum": [
              "TURBO",
              "BALANCED",
              "QUALITY"
            ],
            "title": "Rendering Speed",
            "description": "The rendering speed to use.",
            "default": "BALANCED"
          },
          "image_size": {
            "title": "Image Size",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "The resolution of the generated image",
            "default": "square_hd"
          },
          "sync_mode": {
            "type": "boolean",
            "title": "Sync Mode",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "default": false
          },
          "expand_prompt": {
            "type": "boolean",
            "title": "Expand Prompt",
            "description": "Determine if MagicPrompt should be used in generating the request or not.",
            "default": true
          },
          "negative_prompt": {
            "type": "string",
            "title": "Negative Prompt",
            "description": "Description of what to exclude from an image. Descriptions in the prompt take precedence to descriptions in the negative prompt.",
            "default": ""
          },
          "seed": {
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seed for the random number generator"
          }
        },
        "required": [
          "prompt"
        ],
        "x-fal-order-properties": [
          "image_urls",
          "rendering_speed",
          "color_palette",
          "style_codes",
          "style",
          "expand_prompt",
          "num_images",
          "seed",
          "sync_mode",
          "style_preset",
          "prompt",
          "image_size",
          "negative_prompt"
        ]
      },
      "ColorPalette": {
        "type": "object",
        "properties": {
          "members": {
            "title": "Members",
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ColorPaletteMember"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A list of color palette members that define the color palette"
          },
          "name": {
            "title": "Name",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EMBER",
                  "FRESH",
                  "JUNGLE",
                  "MAGIC",
                  "MELON",
                  "MOSAIC",
                  "PASTEL",
                  "ULTRAMARINE"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "A color palette preset value"
          }
        },
        "title": "ColorPalette",
        "x-fal-order-properties": [
          "members",
          "name"
        ]
      },
      "ColorPaletteMember": {
        "type": "object",
        "title": "ColorPaletteMember",
        "properties": {
          "color_weight": {
            "title": "Color Weight",
            "anyOf": [
              {
                "type": "number",
                "maximum": 1,
                "minimum": 0.05
              },
              {
                "type": "null"
              }
            ],
            "description": "The weight of the color in the color palette",
            "default": 0.5
          },
          "rgb": {
            "$ref": "#/components/schemas/RGBColor",
            "description": "RGB color value for the palette member"
          }
        },
        "required": [
          "rgb"
        ],
        "x-fal-order-properties": [
          "rgb",
          "color_weight"
        ]
      },
      "RGBColor": {
        "type": "object",
        "properties": {
          "g": {
            "type": "integer",
            "title": "G",
            "maximum": 255,
            "description": "Green color value",
            "minimum": 0,
            "default": 0
          },
          "r": {
            "type": "integer",
            "title": "R",
            "maximum": 255,
            "description": "Red color value",
            "minimum": 0,
            "default": 0
          },
          "b": {
            "type": "integer",
            "title": "B",
            "maximum": 255,
            "description": "Blue color value",
            "minimum": 0,
            "default": 0
          }
        },
        "title": "RGBColor",
        "x-fal-order-properties": [
          "r",
          "g",
          "b"
        ]
      },
      "ImageSize": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "title": "Width",
            "maximum": 14142,
            "description": "The width of the generated image.",
            "exclusiveMinimum": 0,
            "default": 512
          },
          "height": {
            "type": "integer",
            "title": "Height",
            "maximum": 14142,
            "description": "The height of the generated image.",
            "exclusiveMinimum": 0,
            "default": 512
          }
        },
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ]
      },
      "IdeogramV3Output": {
        "type": "object",
        "title": "OutputV3",
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "type": "array",
            "title": "Images",
            "examples": [
              [
                {
                  "url": "https://v3.fal.media/files/penguin/lHdRabS80guysb8Zw1kul_image.png"
                }
              ]
            ]
          },
          "seed": {
            "examples": [
              123456
            ],
            "type": "integer",
            "title": "Seed",
            "description": "Seed used for the random number generator"
          }
        },
        "required": [
          "images",
          "seed"
        ],
        "x-fal-order-properties": [
          "images",
          "seed"
        ]
      },
      "File": {
        "type": "object",
        "title": "File",
        "properties": {
          "content_type": {
            "examples": [
              "image/png"
            ],
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file."
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes."
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "The URL where the file can be downloaded from."
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          }
        },
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      }
    }
  },
  "pricingText": "Your request will cost **$0.03** with TURBO, **$0.06** with BALANCED, and **$0.09** with QUALITY.\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
