{
  "endpoint": "fal-ai/veo3.1/fast/reference-to-video",
  "fetchedAt": "2026-09-27",
  "sources": {
    "schema": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/veo3.1/fast/reference-to-video",
    "pricing": "https://fal.ai/models/fal-ai/veo3.1/fast/reference-to-video/llms.txt"
  },
  "input": {
    "$ref": "#/components/schemas/Veo31FastReferenceToVideoInput"
  },
  "output": {
    "$ref": "#/components/schemas/Veo31FastReferenceToVideoOutput"
  },
  "components": {
    "schemas": {
      "Veo31FastReferenceToVideoInput": {
        "properties": {
          "generate_audio": {
            "default": true,
            "description": "Whether to generate audio for the video.",
            "type": "boolean",
            "title": "Generate Audio"
          },
          "safety_tolerance": {
            "default": "4",
            "description": "The safety tolerance level for content moderation. 1 is the most strict (blocks most content), 6 is the least strict.",
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            "type": "string",
            "title": "Safety Tolerance"
          },
          "prompt": {
            "maxLength": 20000,
            "description": "The text prompt describing the video you want to generate",
            "type": "string",
            "examples": [
              "A chimpanzee wearing overalls frolics in the grassy field, gently playing with the butterflies. In the background, a circus tent and carousel beckon."
            ],
            "title": "Prompt"
          },
          "aspect_ratio": {
            "default": "16:9",
            "description": "The aspect ratio of the generated video.",
            "enum": [
              "16:9",
              "9:16"
            ],
            "type": "string",
            "title": "Aspect Ratio"
          },
          "resolution": {
            "default": "720p",
            "description": "The resolution of the generated video.",
            "enum": [
              "720p",
              "1080p",
              "4k"
            ],
            "type": "string",
            "title": "Resolution"
          },
          "image_urls": {
            "items": {
              "type": "string"
            },
            "description": "URLs of the reference images to use for consistent subject appearance",
            "type": "array",
            "examples": [
              [
                "https://storage.googleapis.com/falserverless/example_inputs/veo31-r2v-input-1.png",
                "https://storage.googleapis.com/falserverless/example_inputs/veo31-r2v-input-2.png",
                "https://storage.googleapis.com/falserverless/example_inputs/veo31-r2v-input-3.png"
              ]
            ],
            "title": "Image Urls"
          },
          "duration": {
            "default": "8s",
            "description": "The duration of the generated video.",
            "type": "string",
            "const": "8s",
            "title": "Duration"
          },
          "auto_fix": {
            "default": false,
            "description": "Whether to automatically attempt to fix prompts that fail content policy or other validation checks by rewriting them.",
            "type": "boolean",
            "title": "Auto Fix"
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "aspect_ratio",
          "duration",
          "resolution",
          "generate_audio",
          "auto_fix",
          "safety_tolerance",
          "image_urls"
        ],
        "type": "object",
        "required": [
          "prompt",
          "image_urls"
        ],
        "title": "Veo31ReferenceToVideoInput"
      },
      "Veo31FastReferenceToVideoOutput": {
        "properties": {
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video.",
            "examples": [
              {
                "url": "https://storage.googleapis.com/falserverless/example_outputs/veo31-r2v-output.mp4"
              }
            ]
          }
        },
        "x-fal-order-properties": [
          "video"
        ],
        "type": "object",
        "required": [
          "video"
        ],
        "title": "Veo31ReferenceToVideoOutput"
      },
      "File": {
        "properties": {
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "type": "object",
        "required": [
          "url"
        ],
        "title": "File"
      }
    }
  },
  "pricingText": "For every second of video you generated, you will be charged **$0.10** (audio off) or **$0.15** (audio on). For example, a **5s video** with audio on will cost **$0.75**.\n\nFor more details, see [fal.ai pricing](https://fal.ai/pricing)."
}
