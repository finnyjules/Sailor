    "kind": "color",
    "label": "Fill",
  },
  {
    "default": "glyph",
    "group": "Paint",
    "hint": "Which box this layer is measured against: each glyph, the whole word, or the frame (so the type moves over a fill that stays put).",
    "key": "layer.anchor",
    "kind": "select",
    "label": "Fill anchor",
    "options": [
      "glyph",
      "word",
      "frame",
    ],
  },
  {
    "default": 3,
    "group": "Paint",
    "hint": "Outline width in OUTPUT pixels, so it does not shrink with size. On a solid extrude it outlines the whole fused body — one silhouette, not one outline per copy.",
    "key": "layer.width",
    "kind": "slider",
    "label": "Stroke width",
    "max": 40,
    "min": 0,
    "step": 0.5,
  },
  {
    "default": 1,
    "group": "Paint",
    "hint": "How strong this layer's ink is in the stack. MULTIPLIES the glyph's own motion fade rather than replacing it, so a half-strength layer still fades out with the word.",
    "key": "layer.opacity",
    "kind": "slider",
    "label": "Layer opacity",
    "max": 1,
    "min": 0,
    "step": 0.01,
  },
  {
    "default": "normal",
    "group": "Paint",
    "hint": "How this layer composites onto the layers below it (and onto the background, which this studio draws straight onto).",
    "key": "layer.blend",
    "kind": "select",
    "label": "Layer blend",
    "options": [
      "normal",
      "lighten",
      "screen",
      "add",
      "multiply",
      "darken",
      "overlay",
    ],
  },
  {
    "default": 1,
    "group": "Paint",
    "hint": "How much of this outline is drawn, as a fraction of its longest contour — the letters drawing themselves. 1 is the whole stroke and is the default. It exports as a REAL \`stroke-dasharray\` / \`stroke-dashoffset\`, so a designer opening the SVG gets a dashed stroke they can restyle, not a clipped one. Animate it 0 → 1 (with a stagger, so the letters draw one after another).",
    "key": "layer.draw",
    "kind": "slider",
    "label": "Draw on",
    "max": 1,
    "min": 0,
    "step": 0.01,
  },
  {
    "default": 0,
    "group": "Motion",
    "hint": "Seconds between glyphs. 0 = every glyph animates on one clock; raise it and a track becomes a wave travelling across the word.",
    "key": "motion.stagger.delay",
    "kind": "slider",
    "label": "Stagger",
    "max": 1,
    "min": 0,
    "step": 0.01,
  },
  {
    "default": "forward",
