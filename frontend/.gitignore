# Dependencies
node_modules/

# Nuxt build output
.nuxt/
.output/
dist/

# Runtime/dev caches (preview images, history, etc.)
.cache/

# Playwright test output
test-results/
playwright-report/

# Logs
*.log
logs/

# Local env + server-held secrets (Settings → AI)
.data/
.env
.env.local
.env.*.local
.env.hosted
.env.pre-clerk-backup

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

