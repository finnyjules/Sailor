server/templates/layouts/user-*.json
server/brand-kits/*.json
server/frame-templates/*.json
# Uploaded licensed brand fonts (runtime data, not source)
server/templates/fonts/user/

# Emitted by `npm run build:embed`
public/embed/

# clerk configuration (can include secrets)
/.clerk/
server/data/looks-tuned.json
